    cooldownFail    = 12,
    pathTimeout     = 15,
    waypointTimeout = 5,
    skyHeight       = 120,
    flatThreshold   = 20,            -- 🆕 |ΔY| below this = "same level", skip vertical detour
}

local state     = { running = false, busy = false }
local cooldowns = {}

-- ------------------------------------------------------------
-- HELPERS
-- ------------------------------------------------------------
local function now() return os.clock() end

local function isHidden(pos)
    return math.abs(pos.X) > 1e5 or math.abs(pos.Y) > 1e5 or math.abs(pos.Z) > 1e5
end

local function basePart(obj)
    while obj and not obj:IsA("BasePart") do obj = obj.Parent end
    return obj
end

local function cool(pos, duration, radius)
    cooldowns[pos] = { t = now() + duration, r = radius or CONFIG.cooldownRadius }
end

local function isCooling(pos)
    for p, c in pairs(cooldowns) do
        if c.t < now() then
            cooldowns[p] = nil
        elseif (p - pos).Magnitude <= c.r then
            return true
        end
    end
    return false
end

-- ------------------------------------------------------------
-- PROMPT SCANNER
-- ------------------------------------------------------------
local cache, lastScan = {}, 0

local function scan()
    if now() - lastScan < CONFIG.scanInterval then return cache end
    lastScan = now()

    cache = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt")
           and obj.Enabled
           and obj.ActionText:lower() == CONFIG.actionText:lower() then
            local part = basePart(obj.Parent)
            if part and part.Parent and not isHidden(part.Position) then
                cache[#cache + 1] = { prompt = obj, part = part, pos = part.Position }
            end
        end
    end
    return cache
end

-- ------------------------------------------------------------
-- CORE TWEEN (single segment, no speed cap)
-- ------------------------------------------------------------
local function tweenTo(endPos)
    if not state.running or not hrp or not hrp.Parent then return false end
    local startPos = hrp.Position
    local dist = (endPos - startPos).Magnitude
    if dist < 0.5 then return true end

    local speed    = math.max(CONFIG.speed, 1)
    local duration = dist / speed
    local elapsed  = 0

    while elapsed < duration do
        if not state.running or not hrp.Parent then return false end
        elapsed += RunService.Heartbeat:Wait()
        local alpha = math.min(elapsed / duration, 1)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(startPos:Lerp(endPos, alpha))
    end
    return true
end

-- ------------------------------------------------------------
-- PATHFINDER
-- ------------------------------------------------------------
local Pathfinder = {}

function Pathfinder.compute(fromPos, toPos)
    local spacing = math.max(4, math.min(20, CONFIG.speed / 12))

    local path = PathfindingService:CreatePath({
        AgentRadius     = 2,
        AgentHeight     = 5,
        AgentCanJump    = true,
        AgentCanClimb   = false,
        WaypointSpacing = spacing,
    })

    local ok = pcall(path.ComputeAsync, path, fromPos, toPos)
    if not ok or path.Status ~= Enum.PathStatus.Success then
        return nil
    end
    return path:GetWaypoints()
end

function Pathfinder.walk(waypoints)
    local oldSpeed = humanoid.WalkSpeed
    humanoid.WalkSpeed = math.clamp(CONFIG.speed, 16, 400)

    local startedAt = now()

    for i, wp in ipairs(waypoints) do
        if not state.running or not hrp.Parent then
            humanoid.WalkSpeed = oldSpeed
            return false
        end
        if now() - startedAt > CONFIG.pathTimeout then
            humanoid.WalkSpeed = oldSpeed
            return false
        end

        if i > 1 then
            if wp.Action == Enum.PathWaypointAction.Jump then
                humanoid.Jump = true
            end

            humanoid:MoveTo(wp.Position)

            local wpStart = now()
            while now() - wpStart < CONFIG.waypointTimeout do
                if not state.running or not hrp.Parent then
                    humanoid.WalkSpeed = oldSpeed
                    return false
                end
                if (hrp.Position - wp.Position).Magnitude <= 6 then
                    break
                end
                task.wait(0.03)
            end
        end
    end

    humanoid.WalkSpeed = oldSpeed
    return true
end

function Pathfinder.tween(waypoints)
    for i, wp in ipairs(waypoints) do
        if i == 1 then continue end
        if not tweenTo(wp.Position) then return false end
    end
    return true
end

-- 🆕 Direction-aware vertical skip (works underground too)
function Pathfinder.tweenUp(targetPos)
    local dy    = targetPos.Y - hrp.Position.Y
    local absDy = math.abs(dy)

    -- Case A: same level → pure horizontal, no vertical waste
    if absDy < CONFIG.flatThreshold then
        local flatY = hrp.Position.Y + 3
        if not tweenTo(Vector3.new(targetPos.X, flatY, targetPos.Z)) then return false end
        if not tweenTo(targetPos + Vector3.new(0, 3, 0)) then return false end
        return true
    end

    -- Case B: target ABOVE → ascend → horizontal → descend
    if dy > 0 then
        local skyY = targetPos.Y + CONFIG.skyHeight
        if not tweenTo(Vector3.new(hrp.Position.X, skyY, hrp.Position.Z)) then return false end
        if not tweenTo(Vector3.new(targetPos.X, skyY, targetPos.Z)) then return false end
        if not tweenTo(targetPos + Vector3.new(0, 3, 0)) then return false end
        return true
    end

    -- Case C: target BELOW → drop to just above target → horizontal → settle
    local midY = targetPos.Y + CONFIG.skyHeight
    if not tweenTo(Vector3.new(hrp.Position.X, midY, hrp.Position.Z)) then return false end
    if not tweenTo(Vector3.new(targetPos.X, midY, targetPos.Z)) then return false end
    if not tweenTo(targetPos + Vector3.new(0, 3, 0)) then return false end
    return true
end

function Pathfinder.instant(pos)
    if not hrp or not hrp.Parent then return end
    local jitter = Vector3.new(
        (math.random() - 0.5) * 2,
        3,
        (math.random() - 0.5) * 2
    )
    hrp.CFrame = CFrame.new(pos + jitter)
end

-- ------------------------------------------------------------
-- UNIFIED MOVE (with fallback chain)
-- ------------------------------------------------------------
local function moveTo(targetPos)
    if CONFIG.mode == "Instant" then
        Pathfinder.instant(targetPos)
        return true
    end

    if CONFIG.mode == "TweenUp" then
        return Pathfinder.tweenUp(targetPos)
    end

    local waypoints = Pathfinder.compute(hrp.Position, targetPos)

    if waypoints then
        if CONFIG.mode == "Tween" then
            return Pathfinder.tween(waypoints)
        else
            return Pathfinder.walk(waypoints)
        end
    end

    -- No path → direct fallback
    if CONFIG.mode == "Tween" then
        return tweenTo(targetPos)
    end

    humanoid:MoveTo(targetPos)
    local t0 = now()
    while now() - t0 < CONFIG.waypointTimeout do
        if not state.running then return false end
        if (hrp.Position - targetPos).Magnitude <= 6 then return true end
        task.wait(0.03)
    end
    return false
end

-- ------------------------------------------------------------
-- TRIGGER PROMPT
-- ------------------------------------------------------------
local function fire(prompt)
    if not prompt or not prompt.Parent then return end
    for i = 1, CONFIG.clickBurst do
        task.spawn(function()
            pcall(fireproximityprompt, prompt, 1)
        end)
        if i < CONFIG.clickBurst then task.wait(0.02) end
    end
end

